# .env (par service)

# Auth
JWT_SECRET=<256-bit-secret>
JWT_REFRESH_SECRET=<256-bit-refresh-secret>
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=7d

# Database
DATABASE_URL=postgresql://user:pass@localhost:5432/moneyswift
REDIS_URL=redis://localhost:6379

# MTN MoMo
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_API_KEY=xxxx
MTN_MOMO_USER_ID=xxxx
MTN_ENV=sandbox  # → production en prod

# Orange Money
ORANGE_MONEY_BASE_URL=https://api.orange.com/orange-money-webpay/cm/v1
ORANGE_MONEY_CLIENT_ID=xxxx
ORANGE_MONEY_CLIENT_SECRET=xxxx

# AngaraPay
ANGARA_PAY_URL=https://api.angara-pay.com/v1
ANGARA_PAY_API_KEY=xxxx
ANGARA_PAY_MERCHANT_ID=xxxx
ANGARA_PAY_WEBHOOK_SECRET=xxxx

# Encryption
CARD_ENCRYPTION_KEY=<32-byte-hex-key>  # AES-256